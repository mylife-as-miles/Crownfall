sition-type: absolute; position-left: 16; position-top: 33; width: 314; height: 30; pointer-events: none; z-index-offset: 3; text-align: center;">Why representatives</span></button><button id="Article_the-muster" class="chronicle-option" style="position-type: absolute; position-left: 467; position-top: 150; width: 346; height: 96; "><div style="position-type: absolute; position-left: 0; position-top: 0; width: 346; height: 96; background-color: #100d08; opacity: 0.001; pointer-events: auto;"></div><div id="Article_the-muster_Plate" style="position-type: absolute; position-left: 0; position-top: 0; width: 346; height: 96; background-color: #c5bca9; opacity: 0; pointer-events: none;"></div><div id="Article_the-muster_Mark" class="hotspot-mark" style="position-type: absolute; position-left: 0; position-top: 92; width: 346; height: 4; opacity: 0;"></div><span id="Article_the-muster_Title" class="option-title" style="position-type: absolute; position-left: 16; position-top: 33; width: 314; height: 30; pointer-events: none; z-index-offset: 3; text-align: center;">The muster</span></button><button id="Article_law-of-the-pawn" class="chronicle-option" style="position-type: absolute; position-left: 829; position-top: 150; width: 346; height: 96; "><div style="position-type: absolute; position-left: 0; position-top: 0; width: 346; height: 96; background-color: #100d08; opacity: 0.001; pointer-events: auto;"></div><div id="Article_law-of-the-pawn_Plate" style="position-type: absolute; position-left: 0; position-top: 0; width: 346; height: 96; background-color: #c5bca9; opacity: 0; pointer-events: none;"></div><div id="Article_law-of-the-pawn_Mark" class="hotspot-mark" style="position-type: absolute; position-left: 0; position-top: 92; width: 346; height: 4; opacity: 0;"></div><span id="Article_law-of-the-pawn_Title" class="option-title" style="position-type: absolute; position-left: 16; position-top: 33; width: 314; height: 30; pointer-events: none; z-index-offset: 3; text-align: center;">The law of the pawn</span></button></div><div id="Record_Panel" class="record-panel" style="position-type: absolute; position-left: 361; position-top: 150; width: 558; display: none;"><span id="Record_Marker" class="record-marker" style="width: 502; display: none; pointer-events: none; z-index-offset: 3;"></span><div class="record-meta"><div class="record-chip" style="width: 116;"><span id="Record_Label" class="record-label" style=" pointer-events: none; z-index-offset: 3;">Recorded</span></div><span id="Record_Meaning" class="record-meaning" style="width: 372; pointer-events: none; z-index-offset: 3;">Accepted by all four nations</span></div><span id="Record_Title" class="record-title" style="width: 502; pointer-events: none; z-index-offset: 3;">Korvenia - The Grand Duchy</span><div style="width: 502; height: 1; background-color: #39352a;"></div><span id="Record_Body" class="record-body" style="width: 502; pointer-events: none; z-index-offset: 3;">A duchy of masks and bells beneath a violet eclipse. Its ruler is the Veiled Archduke, a title passed by inheritance. True names are guarded; ward-bells ring against what the eclipse lets in. Its court speaks High Korvenic; its streets, Vesper-Cant. Its Gambit is called Le Jeu des Rois Morts, the Game of Dead Kings.</span></div></div>
<div id="View_Modal" class="view " style="display: none;"><span id="Modal_Title" class="modal-title" style="position-type: absolute; position-left: 170; position-top: 160; width: 940; height: 30; pointer-events: none; z-index-offset: 3; ">CLASSIC</span><span id="Modal_Description" class="modal-body" style="position-type: absolute; position-left: 260; position-top: 226; width: 760; height: 70; pointer-events: none; z-index-offset: 3; ">Classic chess against the computer is not connected to this menu.</span><span id="Modal_Note" class="modal-note" style="position-type: absolute; position-left: 260; position-top: 268; width: 760; height: 60; pointer-events: none; z-index-offset: 3; ">Menu preview only. No gameplay will start here.</span><button id="Btn_Confirm" class="modal-action" style="position-type: absolute; position-left: 480; position-top: 339; width: 128; height: 50; "><div style="position-type: absolute; position-left: 0; position-top: 0; width: 128; height: 50; background-color: #100d08; opacity: 0.001; pointer-events: auto;"></div><div id="Btn_Confirm_Plate" class="modal-plate" style="position-type: absolute; position-left: 0; position-top: 9; width: 128; height: 32; pointer-events: none;"></div><span class="modal-action-label" style="position-type: absolute; position-left: 0; position-top: 13; width: 128; height: 24; pointer-events: none; z-index-offset: 3; ">Confirm</span></button><button id="Btn_Cancel" class="modal-action" style="position-type: absolute; position-left: 672; position-top: 339; width: 128; height: 50; "><div style="position-type: absolute; position-left: 0; position-top: 0; width: 128; height: 50; background-color: #100d08; opacity: 0.001; pointer-events: auto;"></div><div id="Btn_Cancel_Plate" class="modal-plate" style="position-type: absolute; position-left: 0; position-top: 9; width: 128; height: 32; pointer-events: none;"></div><span class="modal-action-label" style="position-type: absolute; position-left: 0; position-top: 13; width: 128; height: 24; pointer-events: none; z-index-offset: 3; ">Cancel</span></button></div>
<div id="View_Onboarding" class="view " style="display: none;"><span id="Onboarding_Title" class="modal-title" style="position-type: absolute; position-left: 170; position-top: 160; width: 940; height: 30; pointer-events: none; z-index-offset: 3; ">WELCOME TO CROWNFALL</span><span id="Onboarding_Body" class="modal-body" style="position-type: absolute; position-left: 260; position-top: 226; width: 760; height: 76; pointer-events: none; z-index-offset: 3; ">Pinch a menu option to select it, or touch a button with your fingertip. This is a menu and arena-art preview; chess gameplay is not connected.</span><button id="Btn_StartVisit" class="modal-action" style="position-type: absolute; position-left: 480; position-top: 339; width: 128; height: 50; "><div style="position-type: absolute; position-left: 0; position-top: 0; width: 128; height: 50; background-color: #100d08; opacity: 0.001; pointer-events: auto;"></div><div id="Btn_StartVisit_Plate" class="modal-plate" style="position-type: absolute; position-left: 0; position-top: 9; width: 128; height: 32; pointer-events: none;"></div><span class="modal-action-label" style="position-type: absolute; position-left: 0; position-top: 13; width: 128; height: 24; pointer-events: none; z-index-offset: 3; ">Start visit</span></button><button id="Btn_SkipVisit" class="modal-action" style="position-type: absolute; position-left: 672; position-top: 339; width: 128; height: 50; "><div style="position-type: absolute; position-left: 0; position-top: 0; width: 128; height: 50; background-color: #100d08; opacity: 0.001; pointer-events: auto;"></div><div id="Btn_SkipVisit_Plate" class="modal-plate" style="position-type: absolute; position-left: 0; position-top: 9; width: 128; height: 32; pointer-events: none;"></div><span class="modal-action-label" style="position-type: absolute; position-left: 0; position-top: 13; width: 128; height: 24; pointer-events: none; z-index-offset: 3; ">Skip visit</span></button></div>
<div id="View_Visit" class="view " style="display: none;"><div id="Visit_Scrim" style="position-type: absolute; position-left: 0; position-top: 0; width: 1280; height: 720; background-color: #39270c; opacity: 0; pointer-events: none;"></div><span id="Visit_Title" class="modal-title" style="position-type: absolute; position-left: 139; position-top: 118; width: 600; height: 30; pointer-events: none; z-index-offset: 3; text-align: left;">ARENA VISIT</span><span id="Visit_Count" class="body" style="position-type: absolute; position-left: 727; position-top: 118; width: 90; height: 30; pointer-events: none; z-index-offset: 3; text-align: right;">1 / 3</span><div class="card" style="position-type: absolute; position-left: 139; position-top: 160; width: 640; height: 357.1875;"><img id="Visit_Image" src="../assets/environments/card-new.webp" style="position-type: absolute; position-left: 0; position-top: 0; width: 640; height: 357.1875; object-fit: fill; opacity: 1; z-index-offset: 0; pointer-events: none;" /></div><span id="Visit_Body" class="body" style="position-type: absolute; position-left: 826; position-top: 211; width: 326; height: 120; pointer-events: none; z-index-offset: 3; ">Explore the supplied arena artwork. This visit does not start a match or change campaign progress.</span><button id="Btn_VisitBack" class="modal-action" style="position-type: absolute; position-left: 826; position-top: 339; width: 128; height: 50; "><div style="position-type: absolute; position-left: 0; position-top: 0; width: 128; height: 50; background-color: #100d08; opacity: 0.001; pointer-events: auto;"></div><div id="Btn_VisitBack_Plate" class="modal-plate" style="position-type: absolute; position-left: 0; position-top: 9; width: 128; height: 32; pointer-events: none;"></div><span class="modal-action-label" style="position-type: absolute; position-left: 0; position-top: 13; width: 128; height: 24; pointer-events: none; z-index-offset: 3; ">Previous</span></button><button id="Btn_VisitNext" class="modal-action" style="position-type: absolute; position-left: 1018; position-top: 339; width: 128; height: 50; "><div style="position-type: absolute; position-left: 0; position-top: 0; width: 128; height: 50; background-color: #100d08; opacity: 0.001; pointer-events: auto;"></div><div id="Btn_VisitNext_Plate" class="modal-plate" style="position-type: absolute; position-left: 0; position-top: 9; width: 128; height: 32; pointer-events: none;"></div><span class="modal-action-label" style="position-type: absolute; position-left: 0; position-top: 13; width: 128; height: 24; pointer-events: none; z-index-offset: 3; ">Next</span></button><button id="Btn_VisitFinish" class="modal-action" style="position-type: absolute; position-left: 826; position-top: 339; width: 192; height: 50; display: none;"><span class="modal-action-label" style="position-type: absolute; position-left: 0; position-top: 13; width: 192; height: 24; pointer-events: none; z-index-offset: 3; ">Finish visit</span></button></div>
<div id="View_Pause" class="view " style="display: none;"><span id="Pause_Title" class="modal-title" style="position-type: absolute; position-left: 170; position-top: 160; width: 940; height: 30; pointer-events: none; z-index-offset: 3; ">PAUSED</span><span id="Pause_Body" class="modal-body" style="position-type: absolute; position-left: 260; position-top: 226; width: 760; height: 76; pointer-events: none; z-index-offset: 3; ">Take your time. Resume the menu, recenter the panel, or return Home.</span><button id="Btn_Resume" class="modal-action" style="position-type: absolute; position-left: 480; position-top: 339; width: 128; height: 50; "><div style="position-type: absolute; position-left: 0; position-top: 0; width: 128; height: 50; background-color: #100d08; opacity: 0.001; pointer-events: auto;"></div><div id="Btn_Resume_Plate" class="modal-plate" style="position-type: absolute; position-left: 0; position-top: 9; width: 128; height: 32; pointer-events: none;"></div><span class="modal-action-label" style="position-type: absolute; position-left: 0; position-top: 13; width: 128; height: 24; pointer-events: none; z-index-offset: 3; ">Resume</span></button><button id="Btn_PauseHome" class="modal-action" style="position-type: absolute; position-left: 672; position-top: 339; width: 128; height: 50; "><div style="position-type: absolute; position-left: 0; position-top: 0; width: 128; height: 50; background-color: #100d08; opacity: 0.001; pointer-events: auto;"></div><div id="Btn_PauseHome_Plate" class="modal-plate" style="position-type: absolute; position-left: 0; position-top: 9; width: 128; height: 32; pointer-events: none;"></div><span class="modal-action-label" style="position-type: absolute; position-left: 0; position-top: 13; width: 128; height: 24; pointer-events: none; z-index-offset: 3; ">Home</span></button></div>
