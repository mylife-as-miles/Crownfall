-offset: 3; ">Back</span></button><button id="Btn_Pause" class="footer-action" style="position-type: absolute; position-left: 580; position-top: 610; width: 70; height: 50; display: none;"><div style="position-type: absolute; position-left: 0; position-top: 0; width: 70; height: 50; background-color: #100d08; opacity: 0.001; pointer-events: auto;"></div><span class="footer-label" style="position-type: absolute; position-left: 0; position-top: 15; width: 70; height: 22; pointer-events: none; z-index-offset: 3; ">Pause</span></button><button id="Btn_Recenter" class="footer-action" style="position-type: absolute; position-left: 668; position-top: 610; width: 90; height: 50; display: none;"><div style="position-type: absolute; position-left: 0; position-top: 0; width: 90; height: 50; background-color: #100d08; opacity: 0.001; pointer-events: auto;"></div><span class="footer-label" style="position-type: absolute; position-left: 0; position-top: 15; width: 90; height: 22; pointer-events: none; z-index-offset: 3; ">Recenter</span></button><button id="Btn_Exit" class="footer-action" style="position-type: absolute; position-left: 776; position-top: 610; width: 70; height: 50; display: none;"><div style="position-type: absolute; position-left: 0; position-top: 0; width: 70; height: 50; background-color: #100d08; opacity: 0.001; pointer-events: auto;"></div><span class="footer-label" style="position-type: absolute; position-left: 0; position-top: 15; width: 70; height: 22; pointer-events: none; z-index-offset: 3; ">Exit VR</span></button><button id="Btn_VisitReplay" class="footer-action" style="position-type: absolute; position-left: 862; position-top: 610; width: 95; height: 50; display: none;"><div style="position-type: absolute; position-left: 0; position-top: 0; width: 95; height: 50; background-color: #100d08; opacity: 0.001; pointer-events: auto;"></div><span class="footer-label" style="position-type: absolute; position-left: 0; position-top: 15; width: 95; height: 22; p