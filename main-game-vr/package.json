{
  "name": "crownfall-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev up --open --foreground",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "generate": "tsx ../scripts/generate-quest-ui.ts",
    "test": "tsx --test src/quest-state.test.ts ../shared/chronicles/chronicles.test.ts",
    "check:sync": "tsx ../scripts/check-menu-sync.ts",
    "dev:runtime": "vite"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0-rc.2",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.185.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.1.0-rc.2",
    "@iwsdk/reference": "1.1.0-rc.2",
    "@iwsdk/vite-plugin-dev": "1.1.0-rc.2",
    "@types/node": "^24.19.2",
    "@types/three": "^0.185.0",
    "tsx": "^4.20.6",
    "typescript": "^5.5.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.185.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
